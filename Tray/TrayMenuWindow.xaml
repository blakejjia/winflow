<Window x:Class="WinFlow.Tray.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="WinFlow menu"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        Focusable="False">

    <Border x:Name="MenuBorder"
            Background="{DynamicResource TrayMenuBackgroundBrush}"
            BorderBrush="{DynamicResource TrayMenuBorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="4"
            MinWidth="240">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35" Color="Black"/>
        </Border.Effect>
        <StackPanel>
            <TextBlock x:Name="StatusHeader"
                       Text="WinFlow — hold CapsLock to speak"
                       FontSize="12"
                       Foreground="{DynamicResource TrayMenuSecondaryBrush}"
                       Margin="12,7,12,7"/>
            <Border Height="1" Background="{DynamicResource TrayMenuDividerBrush}" Margin="8,2,8,4"/>
            <ui:Button x:Name="SettingsButton" Style="{StaticResource TrayMenuItemButtonStyle}"
                       Click="Settings_Click">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Home24" FontSize="16" Margin="0,0,11,0"
                                   Foreground="{DynamicResource TrayMenuSecondaryBrush}"/>
                    <TextBlock Text="Open WinFlow" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:Button>
            <ui:Button x:Name="RunLogButton" Style="{StaticResource TrayMenuItemButtonStyle}"
                       Click="RunLog_Click">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="History24" FontSize="16" Margin="0,0,11,0"
                                   Foreground="{DynamicResource TrayMenuSecondaryBrush}"/>
                    <TextBlock Text="History" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:Button>
            <Border Height="1" Background="{DynamicResource TrayMenuDividerBrush}" Margin="8,4,8,2"/>
            <ui:Button x:Name="QuitButton" Style="{StaticResource TrayMenuItemButtonStyle}"
                       Click="Quit_Click">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="16" Margin="0,0,11,0"
                                   Foreground="{DynamicResource TrayMenuSecondaryBrush}"/>
                    <TextBlock Text="Quit WinFlow" VerticalAlignment="Center"/>
                </StackPanel>
            </ui:Button>
        </StackPanel>
    </Border>
</Window>