<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WinFlow.Core\WinFlow.Core.csproj" />
    <ProjectReference Include="..\WinFlow.Audio\WinFlow.Audio.csproj" />
    <ProjectReference Include="..\WinFlow.WindowsInterops\WinFlow.WindowsInterops.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WPF.UI" Version="3.4.2.7" />
  </ItemGroup>

</Project>
