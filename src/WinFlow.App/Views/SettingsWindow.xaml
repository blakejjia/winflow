<ui:FluentWindow x:Class="WinFlow.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="WinFlow Settings"
        Width="840" Height="640"
        WindowStartupLocation="CenterScreen"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid Margin="16,0,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Windows 11 Fluent TitleBar -->
        <ui:TitleBar
            Grid.Row="0"
            Title="WinFlow Settings"
            Margin="-16,0,-16,8"
            ShowMaximize="False"
            ShowMinimize="True"/>

        <!-- Header -->
        <StackPanel Grid.Row="1" Margin="8,0,8,12">
            <TextBlock Text="WinFlow" FontSize="24" FontWeight="SemiBold"/>
            <TextBlock Text="Context-Aware Voice Dictation &amp; Text Transformation for Windows"
                       FontSize="13"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="2" x:Name="SettingsTabs" Background="Transparent" BorderThickness="0" Margin="4,0,4,0">
            <!-- General Tab -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,12,12">
                    <StackPanel>
                        <!-- Theme Selection Card -->
                        <ui:Card Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Appearance Theme" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="Select your visual style, or follow Windows system theme automatically."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,10" FontSize="12"/>
                                <ComboBox x:Name="ThemeComboBox" Width="220" HorizontalAlignment="Left" SelectionChanged="ThemeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="System (Auto-Switch)" IsSelected="True"/>
                                    <ComboBoxItem Content="Dark Mode"/>
                                    <ComboBoxItem Content="Light Mode"/>
                                </ComboBox>
                            </StackPanel>
                        </ui:Card>

                        <!-- API Key Card -->
                        <ui:Card Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Groq API Key" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock Text="Used for ultrafast Whisper audio transcription and LLM post-processing."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Margin="0,0,0,10" FontSize="12"/>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged" PlaceholderText="gsk_..."/>
                                    <ui:Button Grid.Column="1" Content="Test Key" Click="TestApiKey_Click" Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <!-- Endpoint & Device Card -->
                        <ui:Card Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="API Base URL" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="BaseUrlBox" PlaceholderText="https://api.groq.com/openai/v1" Margin="0,0,0,12"/>

                                <TextBlock Text="Microphone Input Device" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="MicComboBox" HorizontalAlignment="Stretch" Margin="0,0,0,12"/>

                                <TextBlock Text="Transcription Language" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="LanguageBox" PlaceholderText="en, zh, etc. (Leave empty for auto-detect)"/>
                            </StackPanel>
                        </ui:Card>

                        <!-- Options Card -->
                        <ui:Card Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Dictation Behavior" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,8"/>
                                <CheckBox x:Name="PressEnterCheckBox" Content="Press Enter after dictation completes" Margin="0,0,0,8"/>
                                <CheckBox x:Name="PreserveClipboardCheckBox" Content="Preserve clipboard history (Win+V safe non-destructive restore)" IsChecked="True" Margin="0,0,0,8"/>
                                <CheckBox x:Name="ContextCaptureCheckBox" Content="Context-aware capture (active window title &amp; screenshot vision OCR)" IsChecked="True"/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Models Tab -->
            <TabItem Header="Models">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,12,12">
                    <StackPanel>
                        <ui:Card Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Transcription Model (Speech-to-Text)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TranscriptionModelBox" Margin="0,0,0,12"/>

                                <TextBlock Text="Post-Processing Model (LLM Cleanup &amp; Formatter)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="PostProcessingModelBox" Margin="0,0,0,12"/>

                                <TextBlock Text="Fallback Cleanup Model" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="FallbackModelBox" Margin="0,0,0,12"/>

                                <TextBlock Text="Context Vision Model (Screen Scene Synthesis)" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="ContextModelBox"/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Shortcuts Tab -->
            <TabItem Header="Shortcuts">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,12,12">
                    <StackPanel>
                        <ui:Card Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="CapsLock Push-to-Talk Engine" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4"/>
                                <TextBlock Text="WinFlow hooks CapsLock globally and intercepts it only when dictating."
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12" Margin="0,0,0,10"/>
                                <Border Padding="12" CornerRadius="6" Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="• Hold CapsLock: Hold to record, release to insert text" FontWeight="SemiBold" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Double-tap CapsLock: Lock recording mode (hands-free toggle)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Single press while locked: Stop recording and paste" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Shift + CapsLock: Native CapsLock toggle (switch uppercase ON/OFF)" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,6"/>
                                        <TextBlock Text="• Escape: Cancel active recording without inserting" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <CheckBox x:Name="DoubleTapCheckBox" Content="Enable double-tap to lock recording" IsChecked="True"/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Vocabulary Tab -->
            <TabItem Header="Vocabulary">
                <Grid Margin="4,12,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Custom Vocabulary (Comma or newline separated technical terms, names, or jargon)"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Margin="0,0,0,8"/>
                    <ui:TextBox x:Name="VocabularyBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" VerticalAlignment="Stretch"/>
                </Grid>
            </TabItem>

            <!-- Prompts Tab -->
            <TabItem Header="Prompts">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,12,12,12">
                    <StackPanel>
                        <ui:Card Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Custom Cleanup System Prompt" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ui:Button Content="Reset Prompt" Click="ResetSystemPrompt_Click" HorizontalAlignment="Right" Padding="8,2"/>
                                </DockPanel>
                                <ui:TextBox x:Name="SystemPromptBox" Height="140" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ui:Card>

                        <ui:Card Padding="14" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBlock Text="Custom Context Vision Prompt" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <ui:Button Content="Reset Context" Click="ResetContextPrompt_Click" HorizontalAlignment="Right" Padding="8,2"/>
                                </DockPanel>
                                <ui:TextBox x:Name="ContextPromptBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap"/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Run Log Tab -->
            <TabItem x:Name="RunLogTab" Header="Run Log">
                <Grid Margin="4,12,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="HistoryDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Width="70"/>
                            <DataGridTextColumn Header="Latency" Binding="{Binding LatencyMs, StringFormat={}{0}ms}" Width="70"/>
                            <DataGridTextColumn Header="Raw Transcript" Binding="{Binding RawTranscript}" Width="220"/>
                            <DataGridTextColumn Header="Cleaned Text" Binding="{Binding CleanedText}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Command" Binding="{Binding IsCommandMode}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <ui:Button Grid.Row="1" Content="Refresh Log" Click="RefreshHistory_Click" Margin="0,10,0,0" HorizontalAlignment="Right"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,4,0">
            <TextBlock x:Name="StatusMessage" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"/>
            <ui:Button Content="Save &amp; Apply" Click="SaveButton_Click" Appearance="Primary" Height="36" Padding="20,4"/>
        </StackPanel>
    </Grid>
</ui:FluentWindow>
