<Window x:Class="WinFlow.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="WinFlow Settings"
        Width="780" Height="580"
        WindowStartupLocation="CenterScreen"
        Background="#FF1E1E1E"
        Foreground="#FFFFFFFF"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="WinFlow" FontSize="22" FontWeight="SemiBold" Foreground="#FFFFFFFF"/>
            <TextBlock Text="Context-Aware Voice Dictation for Windows" FontSize="13" Foreground="#FF8E8E93" Margin="0,2,0,0"/>
        </StackPanel>

        <!-- Main Tab Control -->
        <TabControl Grid.Row="1" x:Name="SettingsTabs" Background="Transparent" BorderThickness="0">
            <!-- General Tab -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,16,10,10">
                        <TextBlock Text="Groq API Key" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged" Height="36" Padding="8,4" Background="#FF2D2D2D" Foreground="White" BorderBrush="#FF444444"/>
                            <Button Grid.Column="1" Content="Test Key" Click="TestApiKey_Click" Margin="8,0,0,0" Height="36" Padding="14,4"/>
                        </Grid>

                        <TextBlock Text="API Base URL" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="BaseUrlBox" Height="36" Padding="8,6" Background="#FF2D2D2D" Foreground="White" BorderBrush="#FF444444" Margin="0,0,0,16"/>

                        <TextBlock Text="Microphone Input Device" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <ComboBox x:Name="MicComboBox" Height="36" Background="#FF2D2D2D" Foreground="White" Margin="0,0,0,16"/>

                        <TextBlock Text="Transcription Language" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="LanguageBox" Height="36" Padding="8,6" Background="#FF2D2D2D" Foreground="White" BorderBrush="#FF444444" Margin="0,0,0,16"/>

                        <CheckBox x:Name="PressEnterCheckBox" Content="Press Enter after dictation" Margin="0,0,0,10" Foreground="White"/>
                        <CheckBox x:Name="PreserveClipboardCheckBox" Content="Preserve clipboard history (Win+V safe restore)" Margin="0,0,0,10" IsChecked="True" Foreground="White"/>
                        <CheckBox x:Name="ContextCaptureCheckBox" Content="Context-aware capture (active window &amp; vision OCR)" Margin="0,0,0,10" IsChecked="True" Foreground="White"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Models Tab -->
            <TabItem Header="Models">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,16,10,10">
                        <TextBlock Text="Transcription Model (Speech-to-Text)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="TranscriptionModelBox" Height="36" Padding="8,6" Background="#FF2D2D2D" Foreground="White" BorderBrush="#FF444444" Margin="0,0,0,16"/>

                        <TextBlock Text="Post-Processing Model (LLM Cleanup)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="PostProcessingModelBox" Height="36" Padding="8,6" Background="#FF2D2D2D" Foreground="White" BorderBrush="#FF444444" Margin="0,0,0,16"/>

                        <TextBlock Text="Fallback Cleanup Model" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="FallbackModelBox" Height="36" Padding="8,6" Background="#FF2D2D2D" Foreground="White" BorderBrush="#FF444444" Margin="0,0,0,16"/>

                        <TextBlock Text="Context Vision Model (Screen Scene Synthesis)" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <TextBox x:Name="ContextModelBox" Height="36" Padding="8,6" Background="#FF2D2D2D" Foreground="White" BorderBrush="#FF444444" Margin="0,0,0,16"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Shortcuts Tab -->
            <TabItem Header="Shortcuts">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,16,10,10">
                        <TextBlock Text="Hold-to-Talk Shortcut" FontWeight="SemiBold" Margin="0,0,0,6"/>
                        <Border Background="#FF2D2D2D" BorderBrush="#FF444444" BorderThickness="1" CornerRadius="6" Padding="12" Margin="0,0,0,16">
                            <StackPanel>
                                <TextBlock Text="CapsLock (Hold to record, release to insert)" FontWeight="SemiBold" Foreground="#FF34C759"/>
                                <TextBlock Text="• Double-tap CapsLock: Lock recording mode (toggle latch)" Margin="0,6,0,0" Foreground="#FFAAAAAA"/>
                                <TextBlock Text="• Single press while locked: Stop recording and insert text" Margin="0,4,0,0" Foreground="#FFAAAAAA"/>
                                <TextBlock Text="• Shift + CapsLock: Native CapsLock toggle (switch uppercase)" Margin="0,4,0,0" Foreground="#FFAAAAAA"/>
                                <TextBlock Text="• Escape: Cancel active recording" Margin="0,4,0,0" Foreground="#FFAAAAAA"/>
                            </StackPanel>
                        </Border>

                        <CheckBox x:Name="DoubleTapCheckBox" Content="Enable double-tap to lock recording" IsChecked="True" Margin="0,0,0,10" Foreground="White"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Vocabulary Tab -->
            <TabItem Header="Vocabulary">
                <Grid Margin="10,16,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Custom Vocabulary (Comma or newline separated words, names, jargon)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <TextBox x:Name="VocabularyBox" Grid.Row="1" AcceptsReturn="True" TextWrapping="Wrap" Background="#FF2D2D2D" Foreground="White" BorderBrush="#FF444444" Padding="10"/>
                </Grid>
            </TabItem>

            <!-- Prompts Tab -->
            <TabItem Header="Prompts">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,16,10,10">
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Custom Cleanup System Prompt" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="Reset Prompt" Click="ResetSystemPrompt_Click" HorizontalAlignment="Right" Padding="8,2"/>
                        </DockPanel>
                        <TextBox x:Name="SystemPromptBox" Height="140" AcceptsReturn="True" TextWrapping="Wrap" Background="#FF2D2D2D" Foreground="White" BorderBrush="#FF444444" Padding="8" Margin="0,0,0,16"/>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Custom Context Vision Prompt" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            <Button Content="Reset Context" Click="ResetContextPrompt_Click" HorizontalAlignment="Right" Padding="8,2"/>
                        </DockPanel>
                        <TextBox x:Name="ContextPromptBox" Height="100" AcceptsReturn="True" TextWrapping="Wrap" Background="#FF2D2D2D" Foreground="White" BorderBrush="#FF444444" Padding="8" Margin="0,0,0,16"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Run Log Tab -->
            <TabItem x:Name="RunLogTab" Header="Run Log">
                <Grid Margin="10,16,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="HistoryDataGrid"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Background="#FF252525"
                              Foreground="White"
                              BorderBrush="#FF444444"
                              RowBackground="#FF2A2A2A"
                              AlternatingRowBackground="#FF222222">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Timestamp, StringFormat={}{0:HH:mm:ss}}" Width="70"/>
                            <DataGridTextColumn Header="Latency" Binding="{Binding LatencyMs, StringFormat={}{0}ms}" Width="70"/>
                            <DataGridTextColumn Header="Raw Transcript" Binding="{Binding RawTranscript}" Width="220"/>
                            <DataGridTextColumn Header="Cleaned Text" Binding="{Binding CleanedText}" Width="*"/>
                            <DataGridCheckBoxColumn Header="Command" Binding="{Binding IsCommandMode}" Width="75"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="1" Content="Refresh Log" Click="RefreshHistory_Click" Margin="0,10,0,0" HorizontalAlignment="Right" Padding="12,6"/>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Footer Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <TextBlock x:Name="StatusMessage" VerticalAlignment="Center" Margin="0,0,16,0" Foreground="#FF34C759"/>
            <Button Content="Save &amp; Apply" Click="SaveButton_Click" Height="36" Padding="18,4" Background="#FF0A84FF" Foreground="White" FontWeight="SemiBold"/>
        </StackPanel>
    </Grid>
</Window>
