<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- ===================================================================
         WinFlow design tokens.
         Named by purpose, never by hue. Theme-aware values live in
         ThemeDictionaries (Light / Dark / HighContrast); ApplicationThemeManager
         swaps them when the theme changes. Everything else composes the
         WPF-UI palette so accent + theme switching keeps working.
         =================================================================== -->

    <!-- Theme-aware tokens. Defaults below are the Dark values;
         WinFlowTheme.Apply() overwrites them whenever the app theme changes
         (WPF has no native ThemeDictionaries — same approach as the tray menu). -->
    <LinearGradientBrush x:Key="HeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#26303E" Offset="0"/>
        <GradientStop Color="#1B2029" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="HeroBorderBrush" Color="#18FFFFFF"/>
    <SolidColorBrush x:Key="HeroTextBrush" Color="#F5FFFFFF"/>
    <SolidColorBrush x:Key="HeroSecondaryTextBrush" Color="#B3FFFFFF"/>
    <SolidColorBrush x:Key="KeycapBackgroundBrush" Color="#1AFFFFFF"/>
    <SolidColorBrush x:Key="KeycapBorderBrush" Color="#2AFFFFFF"/>
    <SolidColorBrush x:Key="KeycapTextBrush" Color="#E6FFFFFF"/>

    <!-- Accent-derived tints (recomputed when the accent or theme changes) -->
    <SolidColorBrush x:Key="HeroIconBadgeBackgroundBrush" Opacity="0.22"
                     Color="{DynamicResource SystemAccentColorSecondary}"/>
    <SolidColorBrush x:Key="SummaryCardBackgroundBrush" Opacity="0.07"
                     Color="{DynamicResource SystemAccentColorSecondary}"/>
    <SolidColorBrush x:Key="SummaryCardBorderBrush" Opacity="0.22"
                     Color="{DynamicResource SystemAccentColorSecondary}"/>

    <!-- Windows-Settings silhouette: the content area is not a separate card.
         Let the window's Mica show through, same surface as the nav pane. -->
    <SolidColorBrush x:Key="NavigationViewContentBackground" Color="Transparent"/>
    <SolidColorBrush x:Key="NavigationViewContentGridBorderBrush" Color="Transparent"/>

    <!-- ============ Typography helpers ============ -->

    <!-- Page subtitle: the one-line explainer under every page title -->
    <Style x:Key="PageSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Margin" Value="0,4,0,20"/>
        <Setter Property="MaxWidth" Value="640"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>

    <!-- Section header inside a page (Today, Transcript, …) -->
    <Style x:Key="SectionHeaderTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>

    <!-- Small quiet caption -->
    <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <!-- ============ Keyboard keycaps ============ -->
    <Style x:Key="KeycapBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource KeycapBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource KeycapBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="5"/>
        <Setter Property="Padding" Value="7,2"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="KeycapTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource KeycapTextBrush}"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
    </Style>

    <!-- ============ Stat tiles ============ -->
    <Style x:Key="StatValueTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>
    <Style x:Key="StatLabelTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,2,0,0"/>
    </Style>

    <!-- ============ Empty states ============ -->
    <Style x:Key="EmptyStateIconStyle" TargetType="ui:SymbolIcon">
        <Setter Property="FontSize" Value="30"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="EmptyStateTitleStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,12,0,4"/>
    </Style>
    <Style x:Key="EmptyStateBodyStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="HorizontalAlignment" Value="Center"/>
        <Setter Property="TextAlignment" Value="Center"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="MaxWidth" Value="320"/>
    </Style>

    <!-- ============ Icon-only quiet action button ============ -->
    <Style x:Key="QuietIconButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Transparent"/>
        <Setter Property="Padding" Value="7"/>
        <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>

    <!-- ============ Hairline row divider inside grouped cards ============ -->
    <Style x:Key="CardRowDividerStyle" TargetType="Border">
        <Setter Property="Height" Value="1"/>
        <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}"/>
        <Setter Property="Margin" Value="16,0"/>
    </Style>

    <!-- ============ Settings row text ============ -->
    <Style x:Key="SettingTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="SettingDescriptionTextStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        <Setter Property="Margin" Value="0,1,0,0"/>
    </Style>

    <!-- ============ Tray / context menu ============
         WinUI MenuFlyout look: flat borderless rows, subtle hover fill,
         4px inner radius inside an 8px rounded surface. -->
    <Style x:Key="TrayMenuItemButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
        <Setter Property="Appearance" Value="Transparent"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Padding" Value="11,7"/>
        <Setter Property="Margin" Value="0,1"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="{DynamicResource TrayMenuTextBrush}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ui:Button">
                    <Border x:Name="RowBorder" Background="{TemplateBinding Background}"
                            CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBorder" Property="Background"
                                    Value="{DynamicResource TrayMenuHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="RowBorder" Property="Background"
                                    Value="{DynamicResource TrayMenuPressedBrush}"/>
                            <Setter TargetName="RowBorder" Property="Opacity" Value="0.8"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>