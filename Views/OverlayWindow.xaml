<Window x:Class="WinFlow.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WinFlow.Controls"
        Title="WinFlow HUD"
        SizeToContent="WidthAndHeight"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False">

    <!-- The window hugs the pill (SizeToContent): there is no surrounding area at all.
         No shadow, no border, no glow — just the black capsule. -->
    <Border x:Name="PillBorder"
            Background="#FF000000"
            CornerRadius="18"
            Padding="16,10"
            Margin="0,0,0,0">
        <Border.RenderTransform>
            <TranslateTransform x:Name="PillTransform" Y="0"/>
        </Border.RenderTransform>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <!-- Elevated Target Advisory (safety guidance, shown only when needed) -->
            <TextBlock x:Name="ElevatedBadge"
                       Visibility="Collapsed"
                       Text="🛡 Elevated window — run WinFlow as admin to paste here"
                       Foreground="#FFFFD60A"
                       FontSize="10"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,5"/>

            <!-- Recording: white waveform dots only, like WhisperFlow -->
            <controls:WaveformVisualizer x:Name="Waveform" Visibility="Collapsed"/>

            <!-- Transcribing: small white spinner only -->
            <Grid x:Name="TranscribingPanel" Visibility="Collapsed" Width="18" Height="18" HorizontalAlignment="Center">
                <Ellipse Width="18" Height="18" Stroke="#4DFFFFFF" StrokeThickness="2"/>
                <Path x:Name="SpinnerArc" Width="18" Height="18"
                      Stroke="#FFFFFFFF" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Data="M 9,1 A 8,8 0 0 1 17,9"
                      RenderTransformOrigin="0.5,0.5">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="SpinnerRotation"/>
                    </Path.RenderTransform>
                </Path>
            </Grid>

            <!-- Feedback: a lone check -->
            <TextBlock x:Name="FeedbackPanel" Visibility="Collapsed"
                       Text="✓" Foreground="#FFFFFFFF"
                       FontSize="14" FontWeight="Bold"
                       HorizontalAlignment="Center"/>

            <!-- Error: brief message (the only state that needs words) -->
            <StackPanel x:Name="ErrorPanel" Visibility="Collapsed" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="!"
                           Foreground="#FFFF6B6B"
                           FontSize="14" FontWeight="Bold"
                           Margin="0,0,8,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="ErrorText"
                           Text="Something went wrong"
                           Foreground="#FFFFFFFF"
                           FontSize="11"
                           FontFamily="Segoe UI Variable Text, Segoe UI"
                           MaxWidth="240"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
