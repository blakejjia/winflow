<Window x:Class="WinFlow.Views.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WinFlow.Controls"
        Title="WinFlow HUD"
        Width="280" Height="64"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        Focusable="False">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Floating Pill Capsule -->
        <Border Background="#E6181818"
                BorderBrush="#33FFFFFF"
                BorderThickness="1"
                CornerRadius="24"
                Padding="16,6"
                Effect="{DynamicResource ShadowEffect}">
            <Border.Resources>
                <DropShadowEffect x:Key="ShadowEffect"
                                  BlurRadius="16"
                                  ShadowDepth="3"
                                  Opacity="0.45"
                                  Color="Black" />
            </Border.Resources>

            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Elevated Target Advisory Badge -->
                <TextBlock x:Name="ElevatedBadge"
                           Visibility="Collapsed"
                           Text="🛡 Target is elevated — run WinFlow as Admin"
                           Foreground="#FFFFD60A"
                           FontSize="10"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,4"/>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- Recording State Indicator -->
                <Grid x:Name="RecordingPanel" Visibility="Visible">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Glowing Red Dot -->
                        <Ellipse Width="10" Height="10" Fill="#FFFF3B30" Margin="0,0,10,0">
                            <Ellipse.Effect>
                                <DropShadowEffect Color="#FFFF3B30" BlurRadius="8" ShadowDepth="0" Opacity="0.8"/>
                            </Ellipse.Effect>
                        </Ellipse>

                        <!-- Audio Waveform Visualizer -->
                        <controls:WaveformVisualizer x:Name="Waveform" Margin="0,0,10,0" />

                        <!-- Recording Timer -->
                        <TextBlock x:Name="TimerText"
                                   Text="00:00"
                                   Foreground="#F0FFFFFF"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Transcribing State -->
                <Grid x:Name="TranscribingPanel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✦ Transcribing..."
                                   Foreground="#FF0A84FF"
                                   FontSize="13"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Feedback State -->
                <Grid x:Name="FeedbackPanel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="✓ Done"
                                   Foreground="#FF34C759"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <!-- Error State -->
                <Grid x:Name="ErrorPanel" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="ErrorText"
                                   Text="⚠️ Error"
                                   Foreground="#FFFF453A"
                                   FontSize="12"
                                   FontWeight="Medium"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
