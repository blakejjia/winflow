<UserControl x:Class="WinFlow.Views.SettingsPanel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
<ScrollViewer x:Name="PaneGeneral" VerticalScrollBarVisibility="Auto" Padding="0,4,0,4">
                    <StackPanel HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Margin="0,0,0,20" Text="The basics: how you trigger WinFlow, what it hears, and how it looks."/>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Keyboard24"/>
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Shortcut" Style="{StaticResource SettingTitleTextStyle}"/>
                                    <TextBlock Text="Hold CapsLock and speak. Double-tap for hands-free. Shift+CapsLock stays normal." Style="{StaticResource SettingDescriptionTextStyle}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Mic24"/>
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Microphone" Style="{StaticResource SettingTitleTextStyle}"/>
                                    <TextBlock Text="Which input to record from." Style="{StaticResource SettingDescriptionTextStyle}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="MicComboBox" Width="220"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="BookOpenGlobe24"/>
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Spoken language" Style="{StaticResource SettingTitleTextStyle}"/>
                                    <TextBlock Text="Empty = detect automatically. Or a code like en or zh." Style="{StaticResource SettingDescriptionTextStyle}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:TextBox x:Name="LanguageBox" Width="110" PlaceholderText="auto"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Color24"/>
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Theme" Style="{StaticResource SettingTitleTextStyle}"/>
                                    <TextBlock Text="Match Windows, or pick one yourself." Style="{StaticResource SettingDescriptionTextStyle}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="ThemeComboBox" Width="140" SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Use Windows"/>
                                <ComboBoxItem Content="Dark"/>
                                <ComboBoxItem Content="Light"/>
                            </ComboBox>
                        </ui:CardControl>
                    </StackPanel>
                </ScrollViewer>

<ScrollViewer x:Name="PaneSystem" VerticalScrollBarVisibility="Auto" Padding="0,4,0,4">
                    <StackPanel HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Margin="0,0,0,20" Text="How WinFlow behaves alongside the rest of Windows."/>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Power24"/>
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Start with Windows" Style="{StaticResource SettingTitleTextStyle}"/>
                                    <TextBlock Text="WinFlow starts quietly in the tray when you sign in." Style="{StaticResource SettingDescriptionTextStyle}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="AutostartCheckBox"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Games24"/>
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Stay out of fullscreen games" Style="{StaticResource SettingTitleTextStyle}"/>
                                    <TextBlock Text="While a game owns the screen, CapsLock works normally and WinFlow keeps quiet." Style="{StaticResource SettingDescriptionTextStyle}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="PauseGamesCheckBox" IsChecked="True"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="KeyboardTab24"/>
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Press Enter after pasting" Style="{StaticResource SettingTitleTextStyle}"/>
                                    <TextBlock Text="Sends the message right after dictating. You can also just say “press enter”." Style="{StaticResource SettingDescriptionTextStyle}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="PressEnterCheckBox"/>
                        </ui:CardControl>
                    </StackPanel>
                </ScrollViewer>

<ScrollViewer x:Name="PaneAi" VerticalScrollBarVisibility="Auto" Padding="0,4,0,4">
                    <StackPanel HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Margin="0,0,0,20"
                                      Text="One connection, four jobs. Defaults are fast and cheap on Groq."/>

                        <!-- Connection: one grouped card, rows separated by hairlines -->
                        <ui:Card Padding="0" Margin="0,0,0,24">
                            <StackPanel>
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="Groq API key" Style="{StaticResource SettingTitleTextStyle}"/>
                                        <TextBlock Text="Stays on this PC, encrypted with Windows DPAPI." Style="{StaticResource SettingDescriptionTextStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:PasswordBox x:Name="ApiKeyBox" Width="220" PasswordChanged="ApiKeyBox_PasswordChanged" PlaceholderText="gsk_..."/>
                                        <ui:Button Content="Test" Click="TestApiKey_Click" Margin="8,0,0,0"/>
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource CardRowDividerStyle}"/>
                                <Grid Margin="16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="API base URL" Style="{StaticResource SettingTitleTextStyle}"/>
                                        <TextBlock Text="Any OpenAI-compatible endpoint — Ollama, LM Studio, your own server." Style="{StaticResource SettingDescriptionTextStyle}"/>
                                    </StackPanel>
                                    <ui:TextBox x:Name="BaseUrlBox" Grid.Column="1" Width="260" VerticalAlignment="Center"
                                                PlaceholderText="https://api.groq.com/openai/v1"/>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <DockPanel Margin="0,0,0,2">
                            <ui:TextBlock FontTypography="BodyStrong" Text="Models" VerticalAlignment="Center"/>
                            <ui:Button x:Name="RefreshModelsButton" Content="Refresh list" Click="RefreshModels_Click"
                                       Appearance="Transparent" HorizontalAlignment="Right" Padding="8,2">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowClockwise24"/>
                                </ui:Button.Icon>
                            </ui:Button>
                        </DockPanel>
                        <TextBlock x:Name="ModelsStatusText" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <!-- Models: one grouped card, label left / picker right -->
                        <ui:Card Padding="0">
                            <StackPanel>
                                <Grid Margin="16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="270"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Transcription" Style="{StaticResource SettingTitleTextStyle}"/>
                                        <TextBlock Text="Hears your words" Style="{StaticResource SettingDescriptionTextStyle}"/>
                                    </StackPanel>
                                    <ui:AutoSuggestBox x:Name="TranscriptionModelBox" Grid.Column="1" VerticalAlignment="Center"
                                                       PlaceholderText="whisper-large-v3"
                                                       TextChanged="ModelBox_TextChanged" SuggestionChosen="ModelBox_SuggestionChosen"/>
                                </Grid>
                                <Border Style="{StaticResource CardRowDividerStyle}"/>
                                <Grid Margin="16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="270"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Cleanup" Style="{StaticResource SettingTitleTextStyle}"/>
                                        <TextBlock Text="Writes them properly" Style="{StaticResource SettingDescriptionTextStyle}"/>
                                    </StackPanel>
                                    <ui:AutoSuggestBox x:Name="PostProcessingModelBox" Grid.Column="1" VerticalAlignment="Center"
                                                       PlaceholderText="openai/gpt-oss-20b"
                                                       TextChanged="ModelBox_TextChanged" SuggestionChosen="ModelBox_SuggestionChosen"/>
                                </Grid>
                                <Border Style="{StaticResource CardRowDividerStyle}"/>
                                <Grid Margin="16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="270"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Cleanup fallback" Style="{StaticResource SettingTitleTextStyle}"/>
                                        <TextBlock Text="Tried once if cleanup fails" Style="{StaticResource SettingDescriptionTextStyle}"/>
                                    </StackPanel>
                                    <ui:AutoSuggestBox x:Name="FallbackModelBox" Grid.Column="1" VerticalAlignment="Center"
                                                       PlaceholderText="qwen/qwen3-32b"
                                                       TextChanged="ModelBox_TextChanged" SuggestionChosen="ModelBox_SuggestionChosen"/>
                                </Grid>
                                <Border Style="{StaticResource CardRowDividerStyle}"/>
                                <Grid Margin="16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="270"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                        <TextBlock Text="Context vision" Style="{StaticResource SettingTitleTextStyle}"/>
                                        <TextBlock Text="Reads the room while you speak" Style="{StaticResource SettingDescriptionTextStyle}"/>
                                    </StackPanel>
                                    <ui:AutoSuggestBox x:Name="ContextModelBox" Grid.Column="1" VerticalAlignment="Center"
                                                       PlaceholderText="meta-llama/llama-4-scout-17b-16e-instruct"
                                                       TextChanged="ModelBox_TextChanged" SuggestionChosen="ModelBox_SuggestionChosen"/>
                                </Grid>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>

<ScrollViewer x:Name="PanePrivacy" VerticalScrollBarVisibility="Auto" Padding="0,4,0,4">
                    <StackPanel HorizontalAlignment="Stretch">
                        <TextBlock Style="{StaticResource PageSubtitleTextStyle}" Margin="0,0,0,20"
                                      Text="WinFlow has no servers of its own. Audio and text go only to the API endpoint you configure, and history stays on this PC."/>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="MicSparkle24"/>
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Understand my screen" Style="{StaticResource SettingTitleTextStyle}"/>
                                    <TextBlock Text="Reads the active window and a small screenshot so names and jargon come out right. Off = only your audio leaves this PC." Style="{StaticResource SettingDescriptionTextStyle}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="ContextCaptureCheckBox" IsChecked="True"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="ClipboardCheckmark24"/>
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Protect my clipboard" Style="{StaticResource SettingTitleTextStyle}"/>
                                    <TextBlock Text="Whatever you copied comes back after each paste, and Win+V history stays clean." Style="{StaticResource SettingDescriptionTextStyle}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="PreserveClipboardCheckBox" IsChecked="True"/>
                        </ui:CardControl>

                        <ui:Card Padding="16" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="What stays on this PC" FontWeight="Medium" Margin="0,0,0,6"/>
                                <TextBlock FontSize="12" TextWrapping="Wrap" LineHeight="20"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="• Your API key (encrypted with Windows DPAPI)&#10;• Dictation history and word counts&#10;• Meeting notes and transcripts&#10;&#10;Nothing is uploaded anywhere except the API calls you configure. No telemetry, no analytics, no accounts."/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>

        </Grid>

        <ui:InfoBar x:Name="StatusInfoBar" Grid.Row="0"
                    VerticalAlignment="Bottom" HorizontalAlignment="Right"
                    Margin="0,0,24,16" MaxWidth="420"
                    IsOpen="False" IsClosable="True"/>
    </Grid>
</UserControl>
