<ui:FluentWindow x:Class="WinFlow.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="WinFlow Settings"
        Width="860" Height="640"
        MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Settings" ShowMaximize="False" ShowMinimize="False"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Settings rail -->
            <StackPanel Grid.Column="0" Margin="16,16,8,16">
                <TextBlock Text="SETTINGS" FontSize="11" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="12,0,0,8"/>
                <ui:Button x:Name="TabGeneral" Appearance="Transparent" HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Left" Padding="10,8" Click="SettingsTab_Click" Tag="General">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Options24" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="General" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button x:Name="TabSystem" Appearance="Transparent" HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Left" Padding="10,8" Click="SettingsTab_Click" Tag="System">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Desktop24" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="System" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button x:Name="TabAi" Appearance="Transparent" HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Left" Padding="10,8" Click="SettingsTab_Click" Tag="Ai">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="BrainCircuit24" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="AI &amp; models" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button x:Name="TabPrivacy" Appearance="Transparent" HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Left" Padding="10,8" Click="SettingsTab_Click" Tag="Privacy">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Privacy" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
                <ui:Button x:Name="TabPrompts" Appearance="Transparent" HorizontalAlignment="Stretch"
                           HorizontalContentAlignment="Left" Padding="10,8" Click="SettingsTab_Click" Tag="Prompts">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="TextGrammarWand24" FontSize="16" Margin="0,0,10,0"/>
                        <TextBlock Text="Prompts" VerticalAlignment="Center"/>
                    </StackPanel>
                </ui:Button>
            </StackPanel>

            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ============ GENERAL ============ -->
                <ScrollViewer x:Name="PaneGeneral" Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="24,20,28,20">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <ui:TextBlock FontTypography="Title" Text="General" Margin="0,0,0,20"/>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Keyboard24"/>
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Shortcut" FontWeight="Medium"/>
                                    <TextBlock Text="Hold CapsLock and speak. Double-tap for hands-free. Shift+CapsLock stays normal." FontSize="12"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Mic24"/>
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Microphone" FontWeight="Medium"/>
                                    <TextBlock Text="Which input to record from." FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="MicComboBox" Width="220"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="BookOpenGlobe24"/>
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Spoken language" FontWeight="Medium"/>
                                    <TextBlock Text="Empty = detect automatically. Or a code like en or zh." FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:TextBox x:Name="LanguageBox" Width="110" PlaceholderText="auto"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Color24"/>
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Theme" FontWeight="Medium"/>
                                    <TextBlock Text="Match Windows, or pick one yourself." FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ComboBox x:Name="ThemeComboBox" Width="140" SelectionChanged="ThemeComboBox_SelectionChanged">
                                <ComboBoxItem Content="Use Windows"/>
                                <ComboBoxItem Content="Dark"/>
                                <ComboBoxItem Content="Light"/>
                            </ComboBox>
                        </ui:CardControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ SYSTEM ============ -->
                <ScrollViewer x:Name="PaneSystem" Grid.Row="0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="24,20,28,20">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <ui:TextBlock FontTypography="Title" Text="System" Margin="0,0,0,20"/>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="Games24"/>
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Stay out of fullscreen games" FontWeight="Medium"/>
                                    <TextBlock Text="While a game owns the screen, CapsLock works normally and WinFlow keeps quiet." FontSize="12"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="PauseGamesCheckBox" IsChecked="True"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="KeyboardTab24"/>
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Press Enter after pasting" FontWeight="Medium"/>
                                    <TextBlock Text="Sends the message right after dictating. You can also just say “press enter”." FontSize="12"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="PressEnterCheckBox"/>
                        </ui:CardControl>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ AI & MODELS ============ -->
                <ScrollViewer x:Name="PaneAi" Grid.Row="0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="24,20,28,20">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <ui:TextBlock FontTypography="Title" Text="AI &amp; models" Margin="0,0,0,20"/>

                        <ui:TextBlock FontTypography="BodyStrong" Text="Connection" Margin="0,0,0,8"/>
                        <ui:Card Margin="0,0,0,8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Groq API key" FontWeight="Medium" Margin="0,0,0,2"/>
                                <TextBlock Text="Your key stays on this PC, encrypted with Windows DPAPI."
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <ui:PasswordBox x:Name="ApiKeyBox" PasswordChanged="ApiKeyBox_PasswordChanged" PlaceholderText="gsk_..."/>
                                    <ui:Button Grid.Column="1" Content="Test" Click="TestApiKey_Click" Margin="8,0,0,0"/>
                                </Grid>
                            </StackPanel>
                        </ui:Card>
                        <ui:Card Margin="0,0,0,20" Padding="16">
                            <StackPanel>
                                <TextBlock Text="API base URL" FontWeight="Medium" Margin="0,0,0,2"/>
                                <TextBlock Text="Groq by default. Any OpenAI-compatible endpoint works — Ollama, LM Studio, your own server."
                                           FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>
                                <ui:TextBox x:Name="BaseUrlBox" PlaceholderText="https://api.groq.com/openai/v1"/>
                            </StackPanel>
                        </ui:Card>

                        <DockPanel Margin="0,0,0,8">
                            <ui:TextBlock FontTypography="BodyStrong" Text="Models" VerticalAlignment="Center"/>
                            <ui:Button x:Name="RefreshModelsButton" Content="Refresh list" Click="RefreshModels_Click"
                                       Appearance="Transparent" HorizontalAlignment="Right" Padding="8,2">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="ArrowClockwise24"/>
                                </ui:Button.Icon>
                            </ui:Button>
                        </DockPanel>
                        <TextBlock x:Name="ModelsStatusText" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,10"/>

                        <ui:Card Margin="0,0,0,8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Transcription — hears your words" FontWeight="Medium" Margin="0,0,0,8"/>
                                <ui:AutoSuggestBox x:Name="TranscriptionModelBox" PlaceholderText="whisper-large-v3"
                                                   TextChanged="ModelBox_TextChanged" SuggestionChosen="ModelBox_SuggestionChosen"/>
                            </StackPanel>
                        </ui:Card>
                        <ui:Card Margin="0,0,0,8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Cleanup — writes them properly" FontWeight="Medium" Margin="0,0,0,8"/>
                                <ui:AutoSuggestBox x:Name="PostProcessingModelBox" PlaceholderText="openai/gpt-oss-20b"
                                                   TextChanged="ModelBox_TextChanged" SuggestionChosen="ModelBox_SuggestionChosen"/>
                            </StackPanel>
                        </ui:Card>
                        <ui:Card Margin="0,0,0,8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Cleanup fallback" FontWeight="Medium" Margin="0,0,0,8"/>
                                <ui:AutoSuggestBox x:Name="FallbackModelBox" PlaceholderText="qwen/qwen3-32b"
                                                   TextChanged="ModelBox_TextChanged" SuggestionChosen="ModelBox_SuggestionChosen"/>
                            </StackPanel>
                        </ui:Card>
                        <ui:Card Margin="0,0,0,8" Padding="16">
                            <StackPanel>
                                <TextBlock Text="Context vision — reads the room" FontWeight="Medium" Margin="0,0,0,8"/>
                                <ui:AutoSuggestBox x:Name="ContextModelBox" PlaceholderText="meta-llama/llama-4-scout-17b-16e-instruct"
                                                   TextChanged="ModelBox_TextChanged" SuggestionChosen="ModelBox_SuggestionChosen"/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ PRIVACY ============ -->
                <ScrollViewer x:Name="PanePrivacy" Grid.Row="0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="24,20,28,20">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <ui:TextBlock FontTypography="Title" Text="Privacy" Margin="0,0,0,4"/>
                        <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="WinFlow has no servers of its own. Audio and text go only to the API endpoint you configure, and history stays on this PC."
                                      TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="MicSparkle24"/>
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Understand my screen" FontWeight="Medium"/>
                                    <TextBlock Text="Reads the active window and a small screenshot so names and jargon come out right. Off = only your audio leaves this PC." FontSize="12"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="ContextCaptureCheckBox" IsChecked="True"/>
                        </ui:CardControl>

                        <ui:CardControl Margin="0,0,0,8">
                            <ui:CardControl.Icon>
                                <ui:SymbolIcon Symbol="ClipboardCheckmark24"/>
                            </ui:CardControl.Icon>
                            <ui:CardControl.Header>
                                <StackPanel>
                                    <TextBlock Text="Protect my clipboard" FontWeight="Medium"/>
                                    <TextBlock Text="Whatever you copied comes back after each paste, and Win+V history stays clean." FontSize="12"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                            </ui:CardControl.Header>
                            <ui:ToggleSwitch x:Name="PreserveClipboardCheckBox" IsChecked="True"/>
                        </ui:CardControl>

                        <ui:Card Padding="16" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="What stays on this PC" FontWeight="Medium" Margin="0,0,0,6"/>
                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           Text="• Your API key (encrypted with Windows DPAPI)&#10;• Dictation history and word counts&#10;• Meeting notes and transcripts&#10;&#10;Nothing is uploaded anywhere except the API calls you configure. No telemetry, no analytics, no accounts."/>
                            </StackPanel>
                        </ui:Card>
                    </StackPanel>
                </ScrollViewer>

                <!-- ============ PROMPTS ============ -->
                <ScrollViewer x:Name="PanePrompts" Grid.Row="0" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Padding="24,20,28,20">
                    <StackPanel MaxWidth="560" HorizontalAlignment="Left">
                        <ui:TextBlock FontTypography="Title" Text="Prompts" Margin="0,0,0,4"/>
                        <ui:TextBlock FontTypography="Body" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                      Text="The instructions behind cleanup and context. The defaults are battle-tested — edit only if you need to."
                                      TextWrapping="Wrap" Margin="0,0,0,20"/>

                        <DockPanel Margin="0,0,0,8">
                            <ui:TextBlock FontTypography="BodyStrong" Text="Cleanup system prompt" VerticalAlignment="Center"/>
                            <ui:Button Content="Reset" Click="ResetSystemPrompt_Click" HorizontalAlignment="Right"
                                       Appearance="Transparent" Padding="8,2"/>
                        </DockPanel>
                        <ui:TextBox x:Name="SystemPromptBox" Height="180" AcceptsReturn="True" TextWrapping="Wrap"
                                    VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12" Margin="0,0,0,20"/>

                        <DockPanel Margin="0,0,0,8">
                            <ui:TextBlock FontTypography="BodyStrong" Text="Context vision prompt" VerticalAlignment="Center"/>
                            <ui:Button Content="Reset" Click="ResetContextPrompt_Click" HorizontalAlignment="Right"
                                       Appearance="Transparent" Padding="8,2"/>
                        </DockPanel>
                        <ui:TextBox x:Name="ContextPromptBox" Height="130" AcceptsReturn="True" TextWrapping="Wrap"
                                    VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="12"/>
                    </StackPanel>
                </ScrollViewer>

                <!-- footer -->
                <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                        Padding="24,10" Background="{DynamicResource LayerFillColorDefaultBrush}">
                    <ui:Button Content="Save changes" Click="SaveButton_Click" Appearance="Primary"
                               HorizontalAlignment="Right" Height="32" Padding="18,4">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Checkmark24"/>
                        </ui:Button.Icon>
                    </ui:Button>
                </Border>

                <ui:SnackbarPresenter x:Name="SnackbarPresenter" Grid.Row="0" VerticalAlignment="Bottom" Margin="0,0,0,16"/>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
